# Senha do painel /admin (Vercel → Settings → Environment Variables)
ADMIN_PASSWORD=troque-esta-senha

# Domínio raiz: <slug>.ROOT_DOMAIN abre a página do cliente
ROOT_DOMAIN=higsshub.com

# Vercel Blob: criado automaticamente ao conectar o Blob ao projeto (BLOB_STORE_ID ou
# BLOB_READ_WRITE_TOKEN). Sem ele, em `npm run dev` os dados ficam em .data/hub.json.
# BLOB_READ_WRITE_TOKEN=
